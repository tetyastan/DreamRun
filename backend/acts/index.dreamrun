# ====================================================================
# DREAMRUN ADVANCED DEMO SCENARIO
# Showcase file utilizing 100% of the current custom engine syntax layers
# ====================================================================

## --- [config] ---
## Loads a Python module into the runtime env. The module should
## define a variable named `debug_marker` (see config/debug_vars.py).
[audio music "/debug.wav" dbg "0.5~2000" "1.0"/]

[config "game_init.py"/]
> "[config] game_init.py loaded."

# Relative transition: smoothly fades volume from its current state (0.5) to 0.1 over 2000ms
[audio modify dbg "0.1~2000" "1.0"/]

## --- [bg] with leading slash (should be rewritten to /assets/...) ---
[bg "/backgrounds/debug_red.jpg"/]
> "[bg] slash path set."

# Relative instant modification: clamps volume to 0.15 without transitions
[audio modify dbg "0.15" "1.0"/]

## --- [bg] without leading slash (should be used as-is) ---
[bg "http://example.invalid/blue.jpg"/]
> "[bg] absolute URL set."

## --- [bg] with non-existent local file (should be marked MISSING) ---
[bg "/backgrounds/does_not_exist.jpg"/]
> "[bg] missing file check."

## --- [python "inline"] single statement ---
[python "debug_scalar = 15"/]
# Requirement 2: Count from current Python state (0.0 dynamically assumed internally) up to N (15.0)
:hero: > "[python inline] debug_scalar = {debug_scalar ~ ->15:2000} right now, but what it will be next?"

## --- [python "inline"] with expression, no assignment ---
[python "debug_scalar + 1"/]
:hero: > "[python inline expr] still {debug_scalar}"

## --- [python] ... [/python] multi-line, no leading indent ---
[python]
debug_a = 10
debug_b = 20
[/python]
# Plain static substitution example
:hero: > "[python multiline flat] a={debug_a} b={debug_b}"

## --- [python] ... [/python] multi-line, indented ---
[python]
    debug_c = 30
    debug_d = 40
[/python]
# Requirement 1: Count strictly from 0 to N (40) regardless of the actual engine variable value
:hero: > "[python multiline indented] c={debug_c} d={debug_d ~ 0->40:1500}"

## --- [python] ... [/python] with a comment inside ---
[python]
    # This is a Python comment, not a DreamRun comment.
    debug_e = 50
[/python]
# Requirement 3: Count down from a strict start bound (100) down to the current active Python value (50)
:hero: > "[python multiline comment] e={debug_e ~ 100->:2500}"

## --- [pass/] ---
[pass/]
> "[pass] no-op executed."

## --- narrator line ---
> "[narrator] plain narrator line."

## --- variable speaker, existing Character ---
:hero: > "[var speaker] resolved to Character.name."

## --- variable speaker, unknown key (falls back to raw token) ---
:ghost: > "[var speaker fallback] key 'ghost' missing."

## --- literal speaker ---
Debugger > "[literal speaker] name shown verbatim."

## --- literal speaker with spaces in name ---
The Debugger > "[literal speaker spaces] multi-word name."

## --- placeholder substitution from env ---
:hero: > "[placeholder] scalar is {debug_scalar}, sum is {debug_a}."

## --- placeholder with unknown key (should not crash) ---
:hero: > "[placeholder unknown] value is {missing_key}."

## --- [jump] into a simple ref ---
[jump debug_simple_ref/]
> "[jump] returned from debug_simple_ref."

## --- [goto] into a ref (no return) ---
## The ref itself ends with [goto debug_final_ref/], so control
## leaves this act entirely.
[choice]
    [answer "Continue to goto test"]
        [goto debug_goto_target/]
    [/answer]
    [answer "Skip goto test"]
        > "[choice] skipped goto test."
    [/answer]
[/choice]

Nestor > "[after choice] this line is reached only if 'Skip' was chosen."

## --- fall-through target for the choice above ---
[ref debug_final_ref]
    > "[goto target] final ref reached."
    [next "debug.dreamrun"/]
[/ref]

## --- [ref] simple subroutine with return ---
[ref debug_simple_ref]
    > "[ref debug_simple_ref] entered."
    [if 1 == 1]
        > "[ref debug_simple_ref][if 1==1] true branch."
    [/if]
[/ref]

## --- [ref] goto target ---
[ref debug_goto_target]
    > "[ref debug_goto_target] entered via goto."
    > "[ref debug_goto_target] will now jump to debug_final_ref."
    [goto debug_final_ref/]
    > "[ref debug_goto_target] UNREACHABLE."
[/ref]
