[bg "/backgrounds/secret_garden.jpg"/]

> "A hidden garden opens up before you. Strange flowers glow in the twilight."
:hero: > "So this is where the old key leads."

## --- Subroutine: grants a reward based on current stats ---
# Entered via [jump blessing/] — control returns after the block.
[ref blessing]
    > "[Blessing] The flowers pulse with a faint light."
    [if hero.reputation >= 2]
        [python "hero.money += 200"/]
        :hero: > "The garden rewards the respected. I feel richer already."
    [else]
        [python "hero.money += 50"/]
        :hero: > "A small gift for a passing stranger."
    [/if]
[/ref]

## --- Finale label ---
# Entered via [goto finale/] — control does NOT return.
# The block ends with [next], so the story moves to the epilogue.
[ref finale]
    > "The garden closes behind you. Your journey ends here."
    :hero: > "I have {hero.money} coins and reputation {hero.reputation}."
[/ref]

## --- Branch based on the altar visit from Act 0 ---
[if hero.visited_altar == True]
    > "The altar's blessing still lingers on your shoulders."
    [jump blessing/]
[else]
    > "You feel no particular aura here."
[/if]

## --- Nested choice ---
> "Two paths lead out of the garden."

[choice]
    [answer "Take the narrow stone path"]
        > "The path winds between tall hedges."
        [jump blessing/]
        > "You emerge at the edge of the garden."
        [next "game_over.dreamrun"/]
    [/answer]

    [answer "Follow the sound of running water"]
        > "You walk toward a small stream."
        :hero: > "Water means the way out is close."
        [next "game_over.dreamrun"/]
    [/answer]

    # [goto] jumps into the finale label and never returns,
    # so the "Unreachable placeholder" line below is truly unreachable
    # for this branch.
    [answer "Call out for help"]
        [goto finale/]
    [/answer]
[/choice]

> "Unreachable placeholder after the choice."