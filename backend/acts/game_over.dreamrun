## --- Multi-line python: compute a summary value ---
[python]
    hero.total_wealth = hero.money
    hero.summary_line = f"Final wealth: {hero.money} coins, reputation: {hero.reputation}"
[/python]

:hero: > "{hero.summary_line}"

## --- Conditional epilogue based on accumulated state ---
[if hero.reputation >= 2]
    > "Songs will be sung about your kindness."
[elif hero.reputation <= -1]
    > "People will remember you with a shiver."
[else]
    > "You pass through unnoticed, as most travellers do."
[/if]

