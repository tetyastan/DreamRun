{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "DreamRun",
    "scopeName": "source.dreamrun",
    "fileTypes": [
        ".dreamrun"
    ],
    "patterns": [
        { "include": "#comments" },
        { "include": "#python-block" },
        { "include": "#tags" },
        { "include": "#dialogue" }
    ],
    "repository": {

        "comments": {
            "patterns": [
                {
                    "name": "comment.line.section.dreamrun",
                    "match": "^\\s*##.*$"
                },
                {
                    "name": "comment.line.number-sign.dreamrun",
                    "match": "^\\s*#.*$"
                }
            ]
        },

        "python-block": {
            "begin": "^(\\s*)(\\[python\\])\\s*$",
            "end": "^(\\s*)(\\[/python\\])\\s*$",
            "name": "meta.embedded.block.python.dreamrun",
            "beginCaptures": {
                "2": { "name": "keyword.control.tag.dreamrun" }
            },
            "endCaptures": {
                "2": { "name": "keyword.control.tag.dreamrun" }
            },
            "patterns": [
                { "include": "source.python" }
            ]
        },

        "tags": {
            "patterns": [
                {
                    "match": "\\[(/)(python|ref|choice|if|answer)\\]",
                    "captures": {
                        "1": { "name": "punctuation.definition.tag.dreamrun" },
                        "2": { "name": "keyword.control.tag.dreamrun" }
                    }
                },
                {
                    "match": "\\[(choice|else)\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" }
                    }
                },
                {
                    "match": "\\[(pause)\\s+(\\d+)(?:\\s+(block))?\\s*/\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "constant.numeric.duration.dreamrun" },
                        "3": { "name": "keyword.control.modifier.dreamrun" }
                    }
                },
                {
                    "match": "\\[(pass)\\s*/\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" }
                    }
                },
                {
                    "match": "\\[(jump|goto)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*/?\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "variable.other.identifier.dreamrun" }
                    }
                },
                {
                    "match": "\\[(ref)\\s+([A-Za-z_][A-Za-z0-9_]*)\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "variable.other.identifier.dreamrun" }
                    }
                },
                {
                    "match": "\\[(bg|config|next)\\s+(\"[^\"]*\")\\s*/?\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "string.quoted.double.path.dreamrun" }
                    }
                },
                {
                    "match": "\\[(audio)\\s+(sound|music|modify|pause|resume|stop)\\s+(\"[^\"]*\")\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(\"[^\"]*\"))?(?:\\s+(\"[^\"]*\"))?\\s*/?\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "keyword.control.audio-modifier.dreamrun" },
                        "3": { "name": "string.quoted.double.path.dreamrun" },
                        "4": { "name": "variable.other.identifier.dreamrun" },
                        "5": { "name": "string.quoted.double.audio.dreamrun" },
                        "6": { "name": "string.quoted.double.audio.dreamrun" }
                    }
                },
                {
                    "match": "\\[(audio)\\s+(modify|pause|resume|stop)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(\"[^\"]*\"))?(?:\\s+(\"[^\"]*\"))?\\s*/?\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "keyword.control.audio-modifier.dreamrun" },
                        "3": { "name": "variable.other.identifier.dreamrun" },
                        "4": { "name": "string.quoted.double.audio.dreamrun" },
                        "5": { "name": "string.quoted.double.audio.dreamrun" }
                    }
                },
                {
                    "match": "\\[(answer)\\s+(\"[^\"]*\")\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "string.quoted.double.answer.dreamrun" }
                    }
                },
                {
                    "begin": "\\[(if|elif|else\\s+if)\\s+",
                    "end": "\\]",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.conditional.dreamrun" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.tag.dreamrun" }
                    },
                    "contentName": "meta.embedded.inline.python.dreamrun",
                    "patterns": [
                        { "include": "source.python" }
                    ]
                },
                {
                    "begin": "\\[(python)\\s+\"",
                    "end": "\"\\s*/?\\]",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.tag.dreamrun" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.tag.dreamrun" }
                    },
                    "contentName": "meta.embedded.inline.python.dreamrun",
                    "patterns": [
                        { "include": "source.python" }
                    ]
                }
            ]
        },

        "dialogue": {
            "patterns": [
                {
                    "match": "^\\s*(:)([A-Za-z_][A-Za-z0-9_]*)(:)(\\s*>\\s*)(\"[^\"]*\"|'[^']*')",
                    "captures": {
                        "1": { "name": "punctuation.definition.variable.dreamrun" },
                        "2": { "name": "variable.other.speaker.dreamrun" },
                        "3": { "name": "punctuation.definition.variable.dreamrun" },
                        "4": { "name": "punctuation.separator.dialogue.dreamrun" },
                        "5": { "name": "string.quoted.dialogue.dreamrun" }
                    }
                },
                {
                    "match": "^\\s*([A-Za-z][^>\\n]*?)(\\s*>\\s*)(\"[^\"]*\"|'[^']*')",
                    "captures": {
                        "1": { "name": "entity.name.type.speaker.dreamrun" },
                        "2": { "name": "punctuation.separator.dialogue.dreamrun" },
                        "3": { "name": "string.quoted.dialogue.dreamrun" }
                    }
                },
                {
                    "match": "^\\s*(>\\s*)(\"[^\"]*\"|'[^']*')",
                    "captures": {
                        "1": { "name": "punctuation.separator.dialogue.dreamrun" },
                        "2": { "name": "string.quoted.dialogue.dreamrun" }
                    }
                }
            ]
        }
    }
}