{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "DreamRun",
    "scopeName": "source.dreamrun",
    "fileTypes": [
        ".dreamrun"
    ],
    "patterns": [
        { "include": "#comments" },
        { "include": "#ts-block" },
        { "include": "#python-block" },
        { "include": "#tags" },
        { "include": "#dialogue" }
    ],
    "repository": {

        "comments": {
            "patterns": [
                {
                    "name": "comment.line.section.dreamrun",
                    "match": "^\\s*##.*$"
                },
                {
                    "name": "comment.line.number-sign.dreamrun",
                    "match": "^\\s*#.*$"
                }
            ]
        },

        "ts-block": {
            "begin": "^(\\s*)(\\[ts\\])\\s*$",
            "end": "^(\\s*)(\\[/ts\\])\\s*$",
            "name": "meta.embedded.block.ts.dreamrun",
            "beginCaptures": {
                "2": { "name": "keyword.control.tag.dreamrun" }
            },
            "endCaptures": {
                "2": { "name": "keyword.control.tag.dreamrun" }
            },
            "patterns": [
                { "include": "source.ts" }
            ]
        },

        "python-block": {
            "begin": "^(\\s*)(\\[python\\])\\s*$",
            "end": "^(\\s*)(\\[/python\\])\\s*$",
            "name": "meta.embedded.block.python.dreamrun",
            "beginCaptures": {
                "2": { "name": "keyword.control.tag.dreamrun" }
            },
            "endCaptures": {
                "2": { "name": "keyword.control.tag.dreamrun" }
            },
            "patterns": [
                { "include": "source.python" }
            ]
        },

        "tags": {
            "patterns": [

                {
                    "match": "\\[(/)(python|ts|ref|choice|if|pyif|answer)\\]",
                    "captures": {
                        "1": { "name": "punctuation.definition.tag.dreamrun" },
                        "2": { "name": "keyword.control.tag.dreamrun" }
                    }
                },

                {
                    "match": "\\[(choice|else|pyelse)\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" }
                    }
                },

                {
                    "match": "\\[(pause)\\s+(\\d+)(?:\\s+(block))?\\s*/\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "constant.numeric.duration.dreamrun" },
                        "3": { "name": "keyword.control.modifier.dreamrun" }
                    }
                },

                {
                    "match": "\\[(pass)\\s*/\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" }
                    }
                },

                {
                    "match": "\\[(jump|goto)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*/?\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "variable.other.identifier.dreamrun" }
                    }
                },

                {
                    "match": "\\[(ref)\\s+([A-Za-z_][A-Za-z0-9_]*)\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "variable.other.identifier.dreamrun" }
                    }
                },

                {
                    "match": "\\[(config|next)\\s+(\"[^\"]*\")\\s*/?\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "string.quoted.double.path.dreamrun" }
                    }
                },

                {
                    "match": "\\[(image)\\s+(show|modify|hide)\\s+",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "keyword.control.image-modifier.dreamrun" }
                    },
                    "patterns": [
                        { "include": "#image-args" }
                    ]
                },

                {
                    "match": "\\[(audio)\\s+(sound|music)\\s+(\"[^\"]*\")\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(\"[^\"]*\"))?(?:\\s+(\"[^\"]*\"))?\\s*/?\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "keyword.control.audio-modifier.dreamrun" },
                        "3": { "name": "string.quoted.double.path.dreamrun" },
                        "4": { "name": "variable.other.identifier.dreamrun" },
                        "5": { "name": "string.quoted.double.audio.dreamrun" },
                        "6": { "name": "string.quoted.double.audio.dreamrun" }
                    }
                },

                {
                    "match": "\\[(audio)\\s+(modify|pause|resume|stop)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(\"[^\"]*\"))?(?:\\s+(\"[^\"]*\"))?\\s*/?\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "keyword.control.audio-modifier.dreamrun" },
                        "3": { "name": "variable.other.identifier.dreamrun" },
                        "4": { "name": "string.quoted.double.audio.dreamrun" },
                        "5": { "name": "string.quoted.double.audio.dreamrun" }
                    }
                },

                {
                    "match": "\\[(answer)\\s+(\"[^\"]*\")\\]",
                    "captures": {
                        "1": { "name": "keyword.control.tag.dreamrun" },
                        "2": { "name": "string.quoted.double.answer.dreamrun" }
                    }
                },

                {
                    "begin": "\\[(if|elif|else\\s+if|pyif|pyelif|pyelse\\s+if)\\s+",
                    "end": "\\]",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.conditional.dreamrun" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.tag.dreamrun" }
                    },
                    "contentName": "meta.embedded.inline.expression.dreamrun",
                    "patterns": [
                        { "include": "#expression-tokens" }
                    ]
                },

                {
                    "begin": "\\[(ts|python)\\s+\"",
                    "end": "\"\\s*/?\\]",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.tag.dreamrun" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.tag.dreamrun" }
                    },
                    "contentName": "meta.embedded.inline.code.dreamrun",
                    "patterns": [
                        { "include": "source.ts" }
                    ]
                }

            ]
        },

        "image-args": {
            "patterns": [
                {
                    "match": "\"([^\"]*)\"",
                    "captures": {
                        "1": { "name": "string.quoted.double.image.dreamrun" }
                    }
                },
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "variable.other.identifier.dreamrun" }
                    }
                },
                {
                    "match": "\\b(-?\\d+)\\b",
                    "captures": {
                        "1": { "name": "constant.numeric.layer.dreamrun" }
                    }
                },
                {
                    "match": "\\{(?:\\.\\.)?[A-Za-z_][A-Za-z0-9_.]*\\}",
                    "name": "variable.other.template.dreamrun"
                }
            ]
        },

        "expression-tokens": {
            "patterns": [
                {
                    "match": "\\b(and|or|not|in|is|None|True|False)\\b",
                    "name": "keyword.operator.python.dreamrun"
                },
                {
                    "match": "\\b(&&|\\|\\||!)\\b",
                    "name": "keyword.operator.ts.dreamrun"
                },
                {
                    "match": "\\b(if|else|elif)\\b",
                    "name": "keyword.control.flow.dreamrun"
                },
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "variable.other.identifier.dreamrun" }
                    }
                },
                {
                    "match": "\\b(\\d+(?:\\.\\d+)?)\\b",
                    "captures": {
                        "1": { "name": "constant.numeric.dreamrun" }
                    }
                },
                {
                    "match": "\"[^\"]*\"|'[^']*'",
                    "name": "string.quoted.expression.dreamrun"
                }
            ]
        },

        "dialogue": {
            "patterns": [

                {
                    "match": "^\\s*(:)([A-Za-z_][A-Za-z0-9_]*)(:)(\\s*>\\s*)(\"[^\"]*\"|'[^']*')",
                    "captures": {
                        "1": { "name": "punctuation.definition.variable.dreamrun" },
                        "2": { "name": "variable.other.speaker.dreamrun" },
                        "3": { "name": "punctuation.definition.variable.dreamrun" },
                        "4": { "name": "punctuation.separator.dialogue.dreamrun" },
                        "5": { "name": "string.quoted.dialogue.dreamrun" }
                    }
                },

                {
                    "match": "^\\s*([A-Za-z][^>\\n]*?)(\\s*>\\s*)(\"[^\"]*\"|'[^']*')",
                    "captures": {
                        "1": { "name": "entity.name.type.speaker.dreamrun" },
                        "2": { "name": "punctuation.separator.dialogue.dreamrun" },
                        "3": { "name": "string.quoted.dialogue.dreamrun" }
                    }
                },

                {
                    "match": "^\\s*(>\\s*)(\"[^\"]*\"|'[^']*')",
                    "captures": {
                        "1": { "name": "punctuation.separator.dialogue.dreamrun" },
                        "2": { "name": "string.quoted.dialogue.dreamrun" }
                    }
                },

                {
                    "comment": "Template expressions inside dialogue strings",
                    "match": "\\{(?:\\.\\.)?([A-Za-z_][A-Za-z0-9_]*)(?:\\.([A-Za-z_][A-Za-z0-9_]*))?(?:\\s+[^}]*)?\\}",
                    "captures": {
                        "1": { "name": "variable.other.template.dreamrun" },
                        "2": { "name": "variable.other.property.dreamrun" }
                    }
                }

            ]
        }
    }
}