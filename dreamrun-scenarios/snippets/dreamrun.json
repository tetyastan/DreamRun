{
    "DreamRun: choice block": {
        "prefix": "choice",
        "body": [
            "[choice]",
            "    [answer \"${1:Option 1}\"]",
            "        $0",
            "    [/answer]",
            "",
            "    [answer \"${2:Option 2}\"]",
            "        ",
            "    [/answer]",
            "[/choice]"
        ],
        "description": "Branch menu with two answers"
    },

    "DreamRun: answer paired": {
        "prefix": "answer",
        "body": [
            "[answer \"${1:Option text}\"]",
            "    $0",
            "[/answer]"
        ],
        "description": "A single paired answer option"
    },

    "DreamRun: ref block": {
        "prefix": "ref",
        "body": [
            "[ref ${1:name}]",
            "    $0",
            "[/ref]"
        ],
        "description": "Isolated subroutine definition"
    },

    "DreamRun: if / elif / else": {
        "prefix": "if",
        "body": [
            "[if ${1:condition}]",
            "    $0",
            "[elif ${2:other_condition}]",
            "    ",
            "[else]",
            "    ",
            "[/if]"
        ],
        "description": "Conditional block with elif and else"
    },

    "DreamRun: pyif / pyelif / pyelse": {
        "prefix": "pyif",
        "body": [
            "[pyif ${1:condition}]",
            "    $0",
            "[pyelif ${2:other_condition}]",
            "    ",
            "[pyelse]",
            "    ",
            "[/pyif]"
        ],
        "description": "Python conditional block with pyelif and pyelse"
    },

    "DreamRun: ts block": {
        "prefix": "ts",
        "body": [
            "[ts]",
            "    $0",
            "[/ts]"
        ],
        "description": "Multi-line TypeScript block"
    },

    "DreamRun: ts inline": {
        "prefix": "tsi",
        "body": [
            "[ts \"${1:code}\"/]"
        ],
        "description": "Inline single-line TypeScript"
    },

    "DreamRun: python block": {
        "prefix": "python",
        "body": [
            "[python]",
            "    $0",
            "[/python]"
        ],
        "description": "Multi-line Python block"
    },

    "DreamRun: python inline": {
        "prefix": "pyi",
        "body": [
            "[python \"${1:code}\"/]"
        ],
        "description": "Inline single-line Python"
    },

    "DreamRun: narrator line": {
        "prefix": "narr",
        "body": [
            "> \"${1:Text}\""
        ],
        "description": "Narrator dialogue line"
    },

    "DreamRun: variable speaker line": {
        "prefix": "speak",
        "body": [
            ":${1:hero}: > \"${2:Text}\""
        ],
        "description": "Dialogue line with variable speaker"
    },

    "DreamRun: literal speaker line": {
        "prefix": "say",
        "body": [
            "${1:Name} > \"${2:Text}\""
        ],
        "description": "Dialogue line with literal speaker"
    },

    "DreamRun: config import": {
        "prefix": "config",
        "body": [
            "[config \"${1:game_init}\"/]"
        ],
        "description": "Import a config module"
    },

    "DreamRun: next act": {
        "prefix": "next",
        "body": [
            "[next \"${1:chapter.dreamrun}\"/]"
        ],
        "description": "Switch to another act file"
    },

    "DreamRun: jump subroutine": {
        "prefix": "jump",
        "body": [
            "[jump ${1:ref_name}/]"
        ],
        "description": "Subroutine call (returns after the block)"
    },

    "DreamRun: goto label": {
        "prefix": "goto",
        "body": [
            "[goto ${1:ref_name}/]"
        ],
        "description": "Unconditional jump (does not return)"
    },

    "DreamRun: pass": {
        "prefix": "pass",
        "body": [
            "[pass/]"
        ],
        "description": "Deliberate no-op"
    },

    "DreamRun: pause": {
        "prefix": "pause",
        "body": [
            "[pause ${1:2000}${2: block}/]"
        ],
        "description": "Timed pause, optional click blocking"
    },

    "DreamRun: image show": {
        "prefix": "imgshow",
        "body": [
            "[image show \"${1:/images/sprite.png}\" ${2:sprite_id} ${3:10} \"${4:/styles/container.css}\" \"${5:/styles/image.css}\"/]"
        ],
        "description": "Show a layered image"
    },

    "DreamRun: image modify": {
        "prefix": "imgmod",
        "body": [
            "[image modify \"${1:/images/sprite.png}\" ${2:sprite_id} ${3:10} \"${4:/styles/container.css}\" \"${5:/styles/image.css}\"/]"
        ],
        "description": "Modify an existing layered image"
    },

    "DreamRun: image hide": {
        "prefix": "imghide",
        "body": [
            "[image hide ${1:sprite_id}/]"
        ],
        "description": "Hide a layered image"
    },

    "DreamRun: audio music (fade in)": {
        "prefix": "music",
        "body": [
            "[audio music \"${1:/audio/theme.mp3}\" ${2:bgm} \"${3:0.5}~${4:2000}\" \"1.0\"/]"
        ],
        "description": "Play a looping track with a fade-in"
    },

    "DreamRun: audio sound": {
        "prefix": "sound",
        "body": [
            "[audio sound \"${1:/audio/hit.wav}\" ${2:sfx} \"1.0\" \"1.0\"/]"
        ],
        "description": "Play a one-shot sound effect"
    },

    "DreamRun: audio modify": {
        "prefix": "audiomod",
        "body": [
            "[audio modify ${1:bgm} \"${2:0.6}~${3:1000}\" \"1.0\"/]"
        ],
        "description": "Smoothly change volume or pitch of a playing track"
    },

    "DreamRun: audio pause": {
        "prefix": "audiopause",
        "body": [
            "[audio pause ${1:bgm}/]"
        ],
        "description": "Pause a playing track"
    },

    "DreamRun: audio resume": {
        "prefix": "audioresume",
        "body": [
            "[audio resume ${1:bgm}/]"
        ],
        "description": "Resume a paused track"
    },

    "DreamRun: audio stop": {
        "prefix": "audiostop",
        "body": [
            "[audio stop ${1:bgm}/]"
        ],
        "description": "Stop a playing track"
    },

    "DreamRun: animated counter {0..N : ms}": {
        "prefix": "anim",
        "body": [
            "\\{0..${1:100} : ${2:2000}\\}"
        ],
        "description": "Animated counter inside dialogue"
    },

    "DreamRun: animated counter {..var : ms}": {
        "prefix": "animv",
        "body": [
            "\\{..${1:hero.hp} : ${2:2000}\\}"
        ],
        "description": "Animated counter toward a variable's value"
    }
}